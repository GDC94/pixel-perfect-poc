{
  "name": "pixel-perfect-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4173 --strictPort",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:docker": "docker compose -f docker-compose.visual.yml run --rm visual pnpm test:visual",
    "test:visual:docker:update": "docker compose -f docker-compose.visual.yml run --rm visual pnpm test:visual:update",
    "test:visual:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
